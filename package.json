{
  "name": "frontend-path",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "FrontendPath — a learning roadmap from Junior to Middle frontend developer (React + TypeScript), in Azerbaijani, English and Russian",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "i18n:check": "node scripts/i18n.mjs check"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.9"
  }
}
